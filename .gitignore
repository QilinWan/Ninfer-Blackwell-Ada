# Build
build/
build-*/
build*/
cmake-build-*/
*.o
*.obj
*.so
*.a
compile_commands.json
CMakeUserPresets.json
.cache/

# CUDA / profiling artifacts
*.nsys-rep
*.ncu-rep
*.qdrep
*.sqlite

# Python tooling
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# Weight artifacts (large; produced by offline tooling)
*.qus
*.bin
*.safetensors
*.gguf
*.ninfer
*.ninfer.conversion.json
/models/
out/

# Local workspace and transient runtime output
/.local/
/temp/
/temp-*/
/tmp/
/tmp-*/
/AGENTS.override.md
/logs/
*.log
*.tmp
/core
/core.*

# Measurement raw corpora & intermediates (large; produced by offline tooling).
# The small final frequency stats under fixtures/ranking/ ARE tracked; the rest is ignored.
tools/freq_corpus/fixtures/*
!tools/freq_corpus/fixtures/ranking/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
profiles/
.chatgpt/

# Claude Code personal/local settings (may contain API tokens)
.claude/settings.local.json

# TP2 reference goldens are gate inputs: the --tp 1 equivalence suite (tools/tp2/gate.sh) reads
# these logs, so they are tracked data, not run output.
!tools/tp2/reference/golden/*.log
